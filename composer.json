{
	"name": "gottheflag/loom",
	"description": "Framework-agnostic token formatting for strings, identifiers, and portable paths.",
	"type": "library",
	"license": "Apache-2.0",
	"keywords": [
		"formatter",
		"identifier",
		"path",
		"template",
		"token",
		"uid",
		"ulid",
		"uuid"
	],
	"homepage": "https://github.com/gottheflag/loom",
	"authors": [
		{
			"name": "Got The Flag",
			"homepage": "https://github.com/gottheflag"
		}
	],
	"support": {
		"issues": "https://github.com/gottheflag/loom/issues",
		"source": "https://github.com/gottheflag/loom"
	},
	"require": {
		"php": "^8.3",
		"symfony/uid": "^7.2 || ^8.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^12.5.34"
	},
	"autoload": {
		"psr-4": {
			"GotTheFlag\\Loom\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"GotTheFlag\\Loom\\Tests\\": "tests/"
		}
	},
	"config": {
		"sort-packages": true,
		"policy": {
			"advisories": {
				"block": true,
				"audit": "fail"
			},
			"abandoned": {
				"block": true,
				"audit": "fail"
			},
			"malware": {
				"block": true,
				"audit": "fail"
			}
		}
	},
	"scripts": {
		"test": "phpunit",
		"audit": "composer audit --abandoned=fail"
	}
}
