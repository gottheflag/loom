{
	"name": "gottheflag/loom",
	"description": "A small, framework-agnostic formatter for string tokenization.",
	"type": "library",
	"license": "Apache-2.0",
	"require": {
		"php": "^8.3"
	},
	"autoload": {
		"psr-4": {
			"GotTheFlag\\Loom\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"GotTheFlag\\Loom\\Tests\\": "tests/"
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}